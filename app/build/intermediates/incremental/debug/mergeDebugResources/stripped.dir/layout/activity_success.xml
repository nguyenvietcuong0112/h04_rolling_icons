<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8FF"
    android:fitsSystemWindows="false">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutAds"
        android:layout_marginTop="@dimen/_30sdp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <!-- Phone & 3D Icon Floating Illustration -->
        <ImageView
            android:id="@+id/imgSuccess"
            android:layout_width="300dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/img_succes" />

        <!-- Title: Success! -->
        <TextView
            android:id="@+id/txtSuccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/app_font"
            android:gravity="center"
            android:text="@string/success_title"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Description: Your rolling icon theme and background are set -->
        <TextView
            android:id="@+id/txtSuccessDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="28dp"
            android:fontFamily="@font/app_font"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/success_desc"
            android:textColor="#4A4A4A"
            android:textSize="15sp" />


    </LinearLayout>

    <!-- Bottom Native Ad Frame -->
    <FrameLayout
        android:id="@+id/layoutAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnOk"
        android:visibility="gone">

<!--        <include layout="@layout/shimer_top_layout_recycler_native" />-->
    </FrameLayout>
    <!-- Button: Go home -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnOk"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_gravity="center"
        android:layout_margin="@dimen/_16sdp"
        android:background="@drawable/bg_purple_gradient_btn"
        android:fontFamily="@font/app_font"
        android:gravity="center"
        android:text="@string/btn_go_home"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />


</RelativeLayout>
