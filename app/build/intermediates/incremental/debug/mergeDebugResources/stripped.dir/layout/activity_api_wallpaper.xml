<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cosmic_background"
    android:fitsSystemWindows="false">

    <!-- Main Vertical Content Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header (Purple Gradient with Rounded Bottom Corners) -->
        <RelativeLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/bg_wallpaper_header"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/txtHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/app_font"
                android:text="@string/wallpaper_title"
                android:textColor="@color/cosmic_white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Horizontal Scrollable Category Tabs -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryTabRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp" />

        <!-- Main Content Area: 2-Column Wallpaper Grid -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 2-Column Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/wallpaperRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="90dp" />

            <!-- Lottie Loading progress view -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/progressBar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:visibility="gone"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/loading_data" />

            <!-- Empty / Network Error Container -->
            <LinearLayout
                android:id="@+id/layoutErrorOrEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_no_connection" />

                <TextView
                    android:id="@+id/txtErrorMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/app_font"
                    android:gravity="center"
                    android:text="@string/no_internet_or_wallpapers"
                    android:textColor="@color/cosmic_text_secondary"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRetry"
                    android:layout_width="140dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_purple_gradient_btn"
                    android:fontFamily="@font/app_font"
                    android:text="@string/btn_retry"
                    android:textColor="@color/cosmic_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- Bottom Floating Segmented Control (Live vs Static Capsule) -->
    <LinearLayout
        android:id="@+id/layoutSegmentedTabContainer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_segmented_tab_container"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:padding="4dp">

        <!-- Tab Live -->
        <FrameLayout
            android:id="@+id/tabLive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segmented_tab_active"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txtTabLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/app_font"
                android:text="@string/tab_live"
                android:textColor="@color/cosmic_white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Tab Static -->
        <FrameLayout
            android:id="@+id/tabStatic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txtTabStatic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/app_font"
                android:text="@string/tab_static"
                android:textColor="@color/cosmic_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>