<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer purple border layer (Inner alignment 1.5dp) -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#8A52FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Inner white card content inset by 1.5dp stroke width -->
    <item
        android:bottom="5.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cosmic_white" />
            <corners android:radius="14.5dp" />
        </shape>
    </item>
</layer-list>
