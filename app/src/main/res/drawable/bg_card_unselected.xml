<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer light gray border layer (Inner alignment) -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#EAEAEA" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Inner white card content inset by 1dp stroke width -->
    <item
        android:bottom="5dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cosmic_white" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
