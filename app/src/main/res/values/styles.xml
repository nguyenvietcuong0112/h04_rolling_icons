<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base App Theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/cosmic_background</item>
        <item name="android:colorBackground">@color/cosmic_background</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- Theme for MainActivity with matching header preview -->
    <style name="AppTheme.MainActivity" parent="AppTheme">
        <item name="android:windowBackground">@color/transparent</item>
    </style>

    <!-- Theme for FirstOpenWallpaperActivity with dark wallpaper background -->
    <style name="AppTheme.FirstOpen" parent="AppTheme">
        <item name="android:windowBackground">@drawable/bg_wallpaper_00</item>
    </style>

    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- Ad Attribution Badge Style -->
    <style name="AppTheme.AdAttribution" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10sp</item>
        <item name="android:text">Ad</item>
        <item name="android:background">@color/black</item>
        <item name="android:width">18dp</item>
        <item name="android:height">18dp</item>
    </style>
</resources>
