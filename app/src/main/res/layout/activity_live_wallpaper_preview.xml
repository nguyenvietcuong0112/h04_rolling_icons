<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:fitsSystemWindows="false">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:paddingTop="24dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_pur" />

    </RelativeLayout>

    <!-- Center Card Preview Container (Wrapped with outer background and rounded corners) -->
    <FrameLayout
        android:id="@+id/cardPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/_12sdp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:strokeWidth="0dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- ViewPager2 for swiping live wallpapers -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Bottom Gradient Shadow for readability over image -->
                <View
                    android:id="@+id/bottomShadow"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_bottom_overlay" />

                <!-- Set Wallpaper Button stacked INSIDE frame on top of preview -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSetLiveWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_gravity="bottom"
                    android:text="@string/btn_apply"
                    android:textColor="@color/cosmic_white"
                    android:background="@drawable/bg_purple_gradient_livewall_btn"
                    android:stateListAnimator="@null"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:fontFamily="@font/app_font" />

                <!-- Fullscreen Button -->
                <ImageView
                    android:id="@+id/btnFullScreen"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="60dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_btn_fullscreen"
                    android:padding="8dp"
                    android:src="@drawable/ic_fullscreen"
                    android:contentDescription="Fullscreen"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Loading Animation View -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/progressBar"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    app:lottie_rawRes="@raw/loading_data"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true" />

                <!-- Transparent touch overlay in fullscreen mode to tap to exit -->
                <View
                    android:id="@+id/viewFullscreenOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Bottom Banner Container -->
    <FrameLayout
        android:id="@+id/layoutBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <include layout="@layout/ads_shimmer_banner" />
    </FrameLayout>

</LinearLayout>