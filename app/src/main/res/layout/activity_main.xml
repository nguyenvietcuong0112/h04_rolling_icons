<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cosmic_background"
    android:fitsSystemWindows="false">

    <!-- Header Cosmic Wave Background -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="174dp"
        android:background="@drawable/bg_header_curve"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header Bar Contents -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="44dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_3d_custom_icons"
            android:textColor="@color/cosmic_white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/app_font"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnHeaderSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_settings"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/settings_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:descendantFocusability="beforeDescendants"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintBottom_toTopOf="@id/layoutBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:descendantFocusability="beforeDescendants"
            android:paddingBottom="24dp">

            <!-- Card 1: Rolling Icon -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardRollingIcon"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_210"
                android:background="@color/transparent"
                android:clickable="true"
                android:focusable="true">

                <!-- Background Image -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img_rolling_icon"
                    android:scaleType="fitXY"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Content Layout -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start"
                    android:layout_marginStart="36dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guidelineCard1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rolling_icon_title"
                        android:textColor="#352585"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/app_font" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/rolling_icon_desc"
                        android:textColor="#6C748E"
                        android:textSize="13sp"
                        android:fontFamily="@font/app_font"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- Action Button -->
                    <TextView
                        android:id="@+id/btnGetStartedRolling"
                        android:layout_width="@dimen/dp_140"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_rolling_get_started"
                        android:paddingHorizontal="20dp"
                        android:gravity="center"
                        android:text="@string/btn_get_started"
                        android:textColor="@color/cosmic_white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/app_font"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineCard1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.55" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- Native Ad Container -->
            <FrameLayout
                android:id="@+id/layoutAds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp">

                <include layout="@layout/ads_shimmer_native_media_medium" />
            </FrameLayout>

            <!-- Card 2: 3D Spinning & Orbit Icons -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardSpinning3DIcon"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_190"
                android:background="@color/transparent"
                android:clickable="true"
                android:focusable="true">

                <!-- Background Image -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img_spinning_3d_banner"
                    android:scaleType="fitXY"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Content Layout -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start"
                    android:layout_marginStart="36dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guidelineCardSpinning3D">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spinning_3d_title"
                        android:textColor="#B80E46"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/app_font" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/spinning_3d_desc"
                        android:textColor="#6C748E"
                        android:textSize="13sp"
                        android:fontFamily="@font/app_font"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- Action Button -->
                    <TextView
                        android:id="@+id/btnGetStartedSpinning3D"
                        android:layout_width="@dimen/dp_140"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_spinning_3d_get_started"
                        android:paddingHorizontal="20dp"
                        android:gravity="center"
                        android:text="@string/btn_get_started"
                        android:textColor="@color/cosmic_white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/app_font"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineCardSpinning3D"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.55" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card 3: Live Wallpaper (Full width banner card) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardLiveWallpaper"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_190"
                android:background="@color/transparent"
                android:clickable="true"
                android:focusable="true">

                <!-- Background Image -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img_live_wallpaper_banner"
                    android:scaleType="fitXY"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Content Layout -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start"
                    android:layout_marginStart="36dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guidelineCardWallpaper">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live_wallpaper_title"
                        android:textColor="#0D8564"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/app_font" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/live_wallpaper_desc"
                        android:textColor="#6C748E"
                        android:textSize="13sp"
                        android:fontFamily="@font/app_font"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- Action Button -->
                    <TextView
                        android:id="@+id/btnGetStartedWallpaper"
                        android:layout_width="@dimen/dp_140"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_wallpaper_get_started"
                        android:paddingHorizontal="20dp"
                        android:gravity="center"
                        android:text="@string/btn_get_started"
                        android:textColor="@color/cosmic_white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/app_font"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineCardWallpaper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.55" />

            </androidx.constraintlayout.widget.ConstraintLayout>



        </LinearLayout>
    </ScrollView>

    <!-- Bottom Banner Container -->
    <FrameLayout
        android:id="@+id/layoutBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    </FrameLayout>

    <!-- Full-screen Loading Overlay -->
    <FrameLayout
        android:id="@+id/layoutLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieLoadingData"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            app:lottie_rawRes="@raw/loading_data"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

